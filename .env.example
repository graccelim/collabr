# Copy to .env.local and fill in values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=re_...
# Temporary until collabr.sg domain is verified in Resend — then switch to hello@collabr.sg
RESEND_FROM_EMAIL=onboarding@resend.dev
NEXT_PUBLIC_APP_URL=https://collabr.vercel.app
CRON_SECRET=

# ── Subscriptions (Stripe recurring Prices — never hardcode amounts) ─────────
# Creator Pro (charged now). Has its own ISOLATED webhook endpoint.
STRIPE_CREATOR_PRO_PRICE_MONTHLY=
STRIPE_CREATOR_PRO_PRICE_ANNUAL=
STRIPE_CREATOR_PRO_WEBHOOK_SECRET=
# Brand Pro (FREE during beta — these stay inert until BETA_FREE_PRO=false).
# STRIPE_PRO_PRICE_ID is the legacy fallback for Brand Pro monthly.
STRIPE_BRAND_PRO_PRICE_MONTHLY=
STRIPE_BRAND_PRO_PRICE_ANNUAL=
STRIPE_PRO_PRICE_ID=
# Brand Plus (Creator Discovery tier — wired & independent of the analytics suite).
# Set these only if you want to SELL Brand Plus now. Empty = Plus checkout can't complete.
STRIPE_BRAND_PLUS_PRICE_MONTHLY=
STRIPE_BRAND_PLUS_PRICE_ANNUAL=
# Beta-only 50%-off Plus prices (used while BETA_FREE_PRO=true). Optional — the
# checkout falls back to the full-price IDs above when these are empty.
STRIPE_BRAND_PLUS_BETA_PRICE_MONTHLY=
STRIPE_BRAND_PLUS_BETA_PRICE_ANNUAL=
# Boost (paid placement for creators — independent of the analytics suite).
# Set these only if you want the Boost feature live now. Empty = Boost UI hidden.
STRIPE_BOOST_PRICE_MONTHLY=
STRIPE_BOOST_PRICE_PER_APP=

# ── Beta / feature flags ────────────────────────────────────────────────────
# MASTER kill-switch for the analytics/Creator Pro/Connected/AI ecosystem.
# OFF (unset/false) = original pre-analytics product; overrides all flags below.
NEXT_PUBLIC_ANALYTICS_SUITE=false
# Brand Pro is free while this is unset/true. Set to 'false' to charge brands.
BETA_FREE_PRO=true
NEXT_PUBLIC_COLLABR_CERTIFIED=false
NEXT_PUBLIC_CREATOR_PRO=false
NEXT_PUBLIC_CONNECTED_CREATOR=false
NEXT_PUBLIC_CREATOR_STUDIO=false
NEXT_PUBLIC_ANALYTICS_AI=false   # analyst's read + Content Lab + collab analysis + reports + campaign recap

# ── Dev-only mock analytics (test the UI/pipeline before live OAuth) ─────────
# Seeds realistic data through the real deterministic engine. NEVER on in prod
# unless ALLOW_MOCK_IN_PROD=true is ALSO set. No platform API calls are made.
ANALYTICS_MOCK_MODE=false
# ALLOW_MOCK_IN_PROD=true   # unsafe override — leave unset

# ── Connected analytics: first-party social APIs (no Phyllo) ────────────────
# Only needed when NEXT_PUBLIC_ANALYTICS_SUITE=true. Each platform is independent —
# configure only the ones you've set up. NOT needed for the MVP (suite off).
# YouTube: public stats via Data API v3 (API key only — no OAuth, no app review).
YOUTUBE_API_KEY=
# YouTube deep analytics (optional, later) — Google OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Instagram: Meta app w/ Facebook Login (requires Meta App Review + business verification).
META_APP_ID=
META_APP_SECRET=
# TikTok: Login Kit app (requires TikTok app review).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Anthropic (AI — Phase: AI) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
